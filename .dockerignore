# Docker build context — hindari file besar/tidak perlu ikut ke image
.git
.gitignore
.github/
.vscode/
.idea/
*.md
# Dokumen yang dibutuhkan guard 7 titik stamp versi saat pytest dijalankan
# di dalam image (tiga titik stamp berupa .md — lihat modules/version_stamp.py).
!CHANGELOG.md
!docs/internal/USER_LIST.md
!guides/USER_GUIDE.md
*.pyc
__pycache__/
*.py[cod]
backup/
uploads/
*.log
.env
venv/

# Frontend SPA — build dilakukan di stage node (bundle dibuat di sana)
frontend/node_modules/
frontend/dist/
frontend/.vite/

# Hasil build SPA di host (bind-mount ke container, dihasilkan build-spa.sh)
static/app/
