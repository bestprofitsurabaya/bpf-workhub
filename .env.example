# ============================================================
# BPF WorkHub — template .env (v2.30)
# Salin ke .env lalu isi nilai NYATA. JANGAN commit .env.
#   cp .env.example .env && chmod 600 .env
# Generate kredensial DB acak:
#   MYSQL_ROOT_PASSWORD=$(openssl rand -hex 24)
#   MYSQL_PASSWORD=$(openssl rand -hex 24)
#   SECRET_KEY=$(openssl rand -hex 32)
# ============================================================

# --- Web session ---
SECRET_KEY=
# Cookie Secure: true bila HTTPS publik, false hanya utk dev http LAN
SESSION_COOKIE_SECURE=true

# --- MariaDB (db service) ---
# Password root (dipakai backup service + admin/restore manual)
MYSQL_ROOT_PASSWORD=
# Password user aplikasi bpf_user (dipakai web service + healthcheck)
MYSQL_PASSWORD=
# Opsional (default sudah benar utk instalasi standar):
# MYSQL_DATABASE=bpf_asset_system
# MYSQL_USER=bpf_user
# DB_NAME=bpf_asset_system
# DB_USER=bpf_user

# --- Pool DB (opsional) ---
# DB_POOL_SIZE=25
# BRANCH_POOL_SIZE=5
# DB_POOL_RETRIES=3
# Jeda minimal (detik) sebelum pool master dicoba ulang bila init gagal saat
# startup (DB/DNS belum siap). Pool kini di-lazy-init, tidak perlu restart.
# DB_POOL_REINIT_SECONDS=30

# --- Lainnya (opsional) ---
# SESSION_HOURS=12
# SCRAPER_LOG_LEVEL=INFO
# MIKROTIK_HOST=
# MIKROTIK_USER=
# MIKROTIK_PASSWORD=
#
# --- Monitoring backup via Uptime Kuma (opsional, v2.49.2) ---
# Buat 2 monitor tipe "Push" di Uptime Kuma, lalu isi URL-nya di sini:
#   BACKUP_KUMA_HEARTBEAT  → dipanggil tiap backup sukses (heartbeat; jika
#                            tidak dipanggil > 26 jam Kuma alert)
#   BACKUP_MAX_AGE_HOURS   → umur maksimum file backup terbaru (default 30)
#   BACKUP_KUMA_ALERT_URL  → dipanggil (?status=down) bila freshness check gagal
# BACKUP_KUMA_HEARTBEAT=
# BACKUP_KUMA_ALERT_URL=
#
# --- Drill restore otomatis (v2.49.2) ---
# Mingguan (2 field "menit jam", day Minggu) restore backup terbaru ke DB
# sementara lalu di-drop — membuktikan backup benar-benar bisa di-restore.
# Matikan dengan: RESTORE_TEST_CRON=off
# RESTORE_TEST_CRON=0 4 * * 0

# --- ISO 27001 Tahap 2–5 (opsional; default sudah aman) ---
# STEPUP_TTL_SECONDS=600        # masa grant PIN ulang utk aksi uang (min 60)
# STALE_ACCOUNT_DAYS=90         # ambang akun basi Access Review (min 30)
# RETENTION_DAYS_AUDIT_LOGS=1825 # retensi log audit hari (kelas lain: RETENTION_DAYS_*)
