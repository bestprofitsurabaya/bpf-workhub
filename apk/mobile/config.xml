<?xml version='1.0' encoding='utf-8'?>
<widget id="id.co.bpf.calendar" version="1.7.1"
        xmlns="http://www.w3.org/ns/widgets"
        xmlns:cdv="http://cordova.apache.org/ns/1.0">
    <name>BPF Agenda</name>
    <description>
        Kalender agenda harian BPF. Informasi tanggal ini ditampilkan realtime
        dan dikelola admin lewat panel server.
    </description>
    <author email="admin@bpf.co.id">IT BPF</author>

    <content src="index.html" />

    <!-- izin ke server -->
    <access origin="https://nasbpfsby.duckdns.org:8444" />
    <allow-navigation href="https://nasbpfsby.duckdns.org:8444/*" />

    <!-- hanya landscape -->
    <preference name="Orientation" value="landscape" />
    <preference name="AndroidWindowOrientation" value="sensorLandscape" />
    <preference name="FallbackBgColor" value="#10151b" />
    <preference name="BackgroundColor" value="#10151b" />

    <preference name="Fullscreen" value="true" />
    <preference name="KeepRunning" value="true" />
    <preference name="AllowInlineMediaPlayback" value="true" />

    <!-- media agenda boleh berasal dari Nextcloud (port 443) & YouTube -->
    <allow-navigation href="https://nasbpfsby.duckdns.org/*" />
    <allow-navigation href="https://www.youtube-nocookie.com/*" />
    <allow-navigation href="https://www.youtube.com/*" />

    <allow-intent href="http*://*/*" />
    <allow-intent href="tel:*" />

    <platform name="android">
        <!-- Ikon resmi BestProfit (dari logo situs resmi, latar putih + padding) -->
        <icon src="res/icon/android/mdpi.png" density="mdpi" />
        <icon src="res/icon/android/hdpi.png" density="hdpi" />
        <icon src="res/icon/android/xhdpi.png" density="xhdpi" />
        <icon src="res/icon/android/xxhdpi.png" density="xxhdpi" />
        <icon src="res/icon/android/xxxhdpi.png" density="xxxhdpi" />
        <!-- fullscreen tanpa bar hitam: status bar via <preference name="Fullscreen" value="true" /> (theme) -->
        <!-- ikon launcher dinamis (angka tanggal hari ini) + widget 1x1 tanggal -->
        <hook type="after_prepare" src="hooks/dynamic-date.js" />
        <!-- splash bisa ditambahkan nanti -->
        <allow-intent href="market:*" />
    </platform>

    <platform name="ios">
        <!-- Set ikon lengkap (iPhone + iPad + App Store 1024). Dihasilkan oleh
             `node scripts/gen-ios-icons.js` dari res/icon/logo.png (tanpa alpha). -->
        <icon src="res/icon/ios/icon-20.png" width="20" height="20" />
        <icon src="res/icon/ios/icon-20@2x.png" width="40" height="40" />
        <icon src="res/icon/ios/icon-20@3x.png" width="60" height="60" />
        <icon src="res/icon/ios/icon-29.png" width="29" height="29" />
        <icon src="res/icon/ios/icon-29@2x.png" width="58" height="58" />
        <icon src="res/icon/ios/icon-29@3x.png" width="87" height="87" />
        <icon src="res/icon/ios/icon-40.png" width="40" height="40" />
        <icon src="res/icon/ios/icon-40@2x.png" width="80" height="80" />
        <icon src="res/icon/ios/icon-40@3x.png" width="120" height="120" />
        <icon src="res/icon/ios/icon-60@2x.png" width="120" height="120" />
        <icon src="res/icon/ios/icon-60@3x.png" width="180" height="180" />
        <icon src="res/icon/ios/icon-76.png" width="76" height="76" />
        <icon src="res/icon/ios/icon-76@2x.png" width="152" height="152" />
        <icon src="res/icon/ios/icon-83.5@2x.png" width="167" height="167" />
        <icon src="res/icon/ios/icon-1024.png" width="1024" height="1024" />

        <!-- Xcode 16 / iOS 15+ (cordova-ios 7/8) -->
        <preference name="deployment-target" value="15.0" />
        <!-- fokus iPhone: aplikasi kios landscape, tidak perlu screenshot iPad -->
        <preference name="target-device" value="handset" />
        <!-- Landscape kiri/kanan diambil cordova-ios dari <preference Orientation="landscape" />
             di atas (prepare.js -> INFOPLIST_KEY_UISupportedInterfaceOrientations_*), jadi
             tidak perlu edit-config UISupportedInterfaceOrientations. -->

        <!-- setara `<preference name="Fullscreen" />` di Android: status bar disembunyikan -->
        <edit-config file="*-Info.plist" mode="merge" target="UIStatusBarHidden">
            <true />
        </edit-config>
        <edit-config file="*-Info.plist" mode="merge" target="UIViewControllerBasedStatusBarAppearance">
            <false />
        </edit-config>

        <allow-intent href="itms-apps:*" />
    </platform>

    <!-- dideklarasikan di sini agar build yang hanya membaca config.xml (mis. layanan
         build zip di cloud) tetap memasang plugin yang sama dengan build lokal -->
    <plugin name="cordova-plugin-screen-orientation" spec="3.0.4" />
    <plugin name="bpfBridge" spec="file:plugins/bpfBridge" />
</widget>
