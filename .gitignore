# Python
__pycache__/
*.py[cod]
*.pyo
*.egg-info/
.env
venv/
*.bak
*.bak-*
.env.bak-*

# Docker
*.log

# OS
.DS_Store
Thumbs.db

# Uploads (jangan commit foto asli)
uploads/*
!uploads/.gitkeep

# Runtime data News Scraper (state aplikasi, bukan kode)
data/news_scraper/
# Runtime transcoder — hasil konversi media (v2.46.0); .gitkeep dipertahankan
data/transcoder/*
!data/transcoder/.gitkeep

# Backup
backup/
*.sql.gz

# SSL Certs
# certs/ (di-commit untuk self-signed, ignore untuk production)
*.pem
*.key

# IDE
.vscode/
.idea/

# Frontend SPA (node_modules & hasil build tidak di-commit)
frontend/node_modules/
frontend/dist/
frontend/.vite/
# Hasil build SPA yang disalin ke static (bind-mount host → container)
static/app/
NewsScraper_V1.5.1.py
scripts/.cleanup_done_*
backup_*.json
mikrotik-migration/
backups/

# Agen subsiditepat (runtime/rahasia — jangan commit)
agent/subsiditepat/.env
agent/subsiditepat/token.json
agent/subsiditepat/session.txt
agent/subsiditepat/profile/
agent/subsiditepat/data/*
agent/subsiditepat/artifacts/*
agent/subsiditepat/node_modules/
